{
  "name": "@boxthislap/sim",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic F1 race simulator \u2014 pure TS, runs in the browser and the Worker",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "moments": "tsx scripts/moments.ts",
    "bench": "tsx scripts/bench.ts",
    "whatif": "tsx scripts/whatif.ts",
    "combos": "tsx scripts/combos.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
