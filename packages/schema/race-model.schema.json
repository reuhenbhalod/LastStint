{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxthislap.app/schema/race-model.schema.json",
  "title": "RaceModel",
  "description": "Compact fitted model + event timeline for one race. Written by the Python pipeline, consumed by the TypeScript simulator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "race",
    "era",
    "track",
    "compounds",
    "drivers",
    "fuelEffectPerLap",
    "freshTyre",
    "events",
    "decisionMoments",
    "realResult",
    "userSide",
    "rival"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on any breaking change to this schema."
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "laps",
        "takeoverLap",
        "seed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "laps": {
          "type": "integer",
          "minimum": 1
        },
        "takeoverLap": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "scUnlap": {
          "type": "string",
          "enum": [
            "all",
            "duel"
          ],
          "description": "Which lapped cars unlap before a safety-car restart: all of them (the rule, default), or only those between userSide and rival (Abu Dhabi 2021's race-control call)."
        }
      }
    },
    "era": {
      "type": "string",
      "enum": [
        "1988-1993",
        "1994-2009",
        "2010-2013",
        "2014-2025",
        "2026+"
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitLoss",
        "pitLossUnderSC",
        "pitLossUnderVSC",
        "overtakeDifficulty",
        "overtakeModel",
        "dirtyAirPenalty"
      ],
      "properties": {
        "pitLoss": {
          "type": "number"
        },
        "pitLossUnderSC": {
          "type": "number"
        },
        "pitLossUnderVSC": {
          "type": "number"
        },
        "pitLossDeviations": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Measured green-stop losses minus pitLoss, for sampling new stops (slow-stop tail included)."
        },
        "overtakeDifficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overtakeModel": {
          "type": "object",
          "description": "P(pass) = sigmoid(intercept + paceCoef*paceAdvantage + gapCoef*gap), rolled once per lap for a follower within 2s.",
          "additionalProperties": false,
          "required": [
            "intercept",
            "paceCoef",
            "gapCoef"
          ],
          "properties": {
            "intercept": {
              "type": "number"
            },
            "paceCoef": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gapCoef": {
              "type": "number",
              "exclusiveMaximum": 0
            }
          }
        },
        "dirtyAirPenalty": {
          "type": "number",
          "minimum": 0
        },
        "greenLapTime": {
          "type": "number"
        },
        "scLapTime": {
          "type": "number"
        },
        "vscLapTime": {
          "type": "number"
        }
      }
    },
    "compounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "degPerLap",
          "cliffLap"
        ],
        "properties": {
          "offset": {
            "type": "number"
          },
          "degPerLap": {
            "type": "number",
            "minimum": 0
          },
          "cliffLap": {
            "type": "integer",
            "minimum": 1
          },
          "cliffDegPerLap": {
            "type": "number",
            "minimum": 0,
            "description": "Extra seconds per lap of tyre age past cliffLap. Absent: no fitted cliff."
          }
        }
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "team",
          "basePace",
          "noise",
          "stateAtTakeover",
          "realStrategy"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4
          },
          "team": {
            "type": "string"
          },
          "basePace": {
            "type": "number"
          },
          "noise": {
            "type": "number",
            "minimum": 0
          },
          "stateAtTakeover": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "gapAhead",
              "compound",
              "tyreAge",
              "compoundsUsed"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "gapAhead": {
                "type": "number",
                "minimum": 0
              },
              "compound": {
                "type": "string"
              },
              "tyreAge": {
                "type": "integer",
                "minimum": 0
              },
              "compoundsUsed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "description": "Dry compounds run up to and including the takeover lap (two-compound rule)."
              }
            }
          },
          "realStrategy": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lap",
                "to"
              ],
              "properties": {
                "lap": {
                  "type": "integer",
                  "minimum": 1
                },
                "to": {
                  "type": "string"
                },
                "loss": {
                  "type": "number",
                  "description": "Measured time lost to this real stop (green/VSC stops; frozen like other real events). Absent: the track's figure for the flag."
                },
                "optional": {
                  "type": "boolean",
                  "description": "A fastest-lap stop (late, green, 2019-2024, made with a free gap behind): in live play the rival takes it only if the gap behind at the start of the out-lap exceeds its cost; replays keep it (schema v10)."
                }
              }
            }
          },
          "wetPace": {
            "type": "number",
            "description": "A wet race: the driver's extra share of a lap on a wet track beyond the weather curves (negative: quicker in the wet), fading in up to wetness 0.1 (pipeline/wet.py)."
          }
        }
      }
    },
    "freshTyre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bonus",
        "laps"
      ],
      "description": "Lap-time bonus (s, negative = faster) on a new set's first laps after the out-lap: full weight on the first, fading linearly over `laps` laps.",
      "properties": {
        "bonus": {
          "type": "number"
        },
        "laps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fuelEffectPerLap": {
      "type": "number",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lap",
          "type"
        ],
        "properties": {
          "lap": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "SC",
              "VSC",
              "RED",
              "RAIN",
              "RETIREMENT"
            ]
          },
          "laps": {
            "type": "integer",
            "minimum": 1
          },
          "driver": {
            "type": "string"
          }
        }
      }
    },
    "decisionMoments": {
      "type": "array",
      "description": "Approved decision moments (data/moments/<race>.json; proposed by the sim's moment finder, picked by a human). The calls in each option are validated by the simulator.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lap",
          "trigger",
          "target",
          "options",
          "realOptionId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lap": {
            "type": "integer",
            "minimum": 1
          },
          "trigger": {
            "enum": [
              "SC",
              "VSC",
              "rivalPit",
              "undercut",
              "cliff",
              "takeover"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "kind"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "decisions"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "decisions": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "realOptionId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "candidateMomentLaps": {
      "type": "array",
      "description": "Laps with a strategic event after takeover (SC/VSC starts, stops): input for the moment finder.",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "realResult": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userSide": {
      "type": "string",
      "description": "Driver code the user controls \u2014 always the hard/controversial side."
    },
    "rival": {
      "type": "string",
      "description": "Driver code of the direct rival, which reacts to the user's calls; every other car follows its real strategy."
    },
    "reconstructed": {
      "type": "boolean",
      "description": "True for hand-built races without official lap timing (labelled in the UI)."
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curves",
        "wetness"
      ],
      "description": "A wet race (docs/weather-spec.md): the share of a dry lap each tyre class loses at wetness w (data/wet.json) and the track's wetness on each lap (index lap - 1), fitted by pipeline/wet.py.",
      "properties": {
        "curves": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slick",
            "inter",
            "wet"
          ],
          "properties": {
            "slick": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a",
                "b"
              ],
              "properties": {
                "a": {
                  "type": "number",
                  "minimum": 0
                },
                "b": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "inter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "dry",
                "wet",
                "best"
              ],
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0
                },
                "dry": {
                  "type": "number",
                  "minimum": 0
                },
                "wet": {
                  "type": "number",
                  "minimum": 0
                },
                "best": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "wet": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "dry",
                "wet",
                "best"
              ],
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0
                },
                "dry": {
                  "type": "number",
                  "minimum": 0
                },
                "wet": {
                  "type": "number",
                  "minimum": 0
                },
                "best": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "wetness": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
