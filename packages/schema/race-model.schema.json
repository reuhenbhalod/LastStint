{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laststint.com/schema/race-model.schema.json",
  "title": "RaceModel",
  "description": "Compact fitted model + event timeline for one race. Written by the Python pipeline, consumed by the TypeScript simulator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "race",
    "era",
    "track",
    "compounds",
    "drivers",
    "fuelEffectPerLap",
    "freshTyre",
    "events",
    "decisionMoments",
    "realResult",
    "userSide",
    "rival"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "The schema version the file was written with. Every change so far is additive (new fields are optional, with defaults matching the older behaviour), so a reader accepts any version up to the current one (v11: eras, provenance, rules, events[].storylineEvent, scUnlap none)."
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "laps",
        "takeoverLap",
        "seed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "laps": {
          "type": "integer",
          "minimum": 1
        },
        "takeoverLap": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "scUnlap": {
          "type": "string",
          "enum": [
            "all",
            "duel",
            "none"
          ],
          "description": "Which lapped cars unlap before a safety-car restart: all of them (the rule since 2012, default), only those between userSide and rival (Abu Dhabi 2021's race-control call), or none (before 2012, roadmap R5; the sim treats it as all until eras build plan 4.1)."
        }
      }
    },
    "era": {
      "type": "string",
      "enum": [
        "1988-1993",
        "1994-2009",
        "2010-2013",
        "2014-2025",
        "2026+"
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitLoss",
        "pitLossUnderSC",
        "pitLossUnderVSC",
        "overtakeDifficulty",
        "overtakeModel",
        "dirtyAirPenalty"
      ],
      "properties": {
        "pitLoss": {
          "type": "number"
        },
        "pitLossUnderSC": {
          "type": "number"
        },
        "pitLossUnderVSC": {
          "type": "number"
        },
        "pitLossDeviations": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Measured green-stop losses minus pitLoss, for sampling new stops (slow-stop tail included)."
        },
        "overtakeDifficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overtakeModel": {
          "type": "object",
          "description": "P(pass) = sigmoid(intercept + paceCoef*paceAdvantage + gapCoef*gap), rolled once per lap for a follower within 2s.",
          "additionalProperties": false,
          "required": [
            "intercept",
            "paceCoef",
            "gapCoef"
          ],
          "properties": {
            "intercept": {
              "type": "number"
            },
            "paceCoef": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gapCoef": {
              "type": "number",
              "exclusiveMaximum": 0
            }
          }
        },
        "dirtyAirPenalty": {
          "type": "number",
          "minimum": 0
        },
        "greenLapTime": {
          "type": "number"
        },
        "scLapTime": {
          "type": "number"
        },
        "vscLapTime": {
          "type": "number"
        }
      }
    },
    "compounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "degPerLap",
          "cliffLap"
        ],
        "properties": {
          "offset": {
            "type": "number"
          },
          "degPerLap": {
            "type": "number",
            "minimum": 0
          },
          "cliffLap": {
            "type": "integer",
            "minimum": 1
          },
          "cliffDegPerLap": {
            "type": "number",
            "minimum": 0,
            "description": "Extra seconds per lap of tyre age past cliffLap. Absent: no fitted cliff."
          },
          "provenLaps": {
            "type": "integer",
            "minimum": 1,
            "description": "The longest stint run on this compound in the real race (tyre age). Its life is at least this: real teams ran it that long."
          }
        }
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "team",
          "basePace",
          "noise",
          "stateAtTakeover",
          "realStrategy"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4
          },
          "team": {
            "type": "string"
          },
          "basePace": {
            "type": "number"
          },
          "noise": {
            "type": "number",
            "minimum": 0
          },
          "stateAtTakeover": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "gapAhead",
              "compound",
              "tyreAge",
              "compoundsUsed"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "gapAhead": {
                "type": "number",
                "minimum": 0
              },
              "compound": {
                "type": "string"
              },
              "tyreAge": {
                "type": "integer",
                "minimum": 0
              },
              "compoundsUsed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true,
                "description": "Dry compounds run up to and including the takeover lap (two-compound rule)."
              }
            }
          },
          "realStrategy": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lap",
                "to"
              ],
              "properties": {
                "lap": {
                  "type": "integer",
                  "minimum": 1
                },
                "to": {
                  "type": "string"
                },
                "loss": {
                  "type": "number",
                  "description": "Measured time lost to this real stop (green/VSC stops; frozen like other real events). Absent: the track's figure for the flag."
                },
                "optional": {
                  "type": "boolean",
                  "description": "A fastest-lap stop (late, green, 2019-2024, made with a free gap behind): in live play the rival takes it only if the gap behind at the start of the out-lap exceeds its cost; replays keep it (schema v10)."
                }
              }
            }
          },
          "wetPace": {
            "type": "number",
            "description": "A wet race: the driver's extra share of a lap on a wet track beyond the weather curves (negative: quicker in the wet), fading in up to wetness 0.1 (pipeline/wet.py)."
          }
        }
      }
    },
    "freshTyre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bonus",
        "laps"
      ],
      "description": "Lap-time bonus (s, negative = faster) on a new set's first laps after the out-lap: full weight on the first, fading linearly over `laps` laps.",
      "properties": {
        "bonus": {
          "type": "number"
        },
        "laps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fuelEffectPerLap": {
      "type": "number",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lap",
          "type"
        ],
        "properties": {
          "lap": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "SC",
              "VSC",
              "RED",
              "RAIN",
              "RETIREMENT",
              "FAULT"
            ]
          },
          "laps": {
            "type": "integer",
            "minimum": 1,
            "description": "How many laps the event lasts. A FAULT without it lasts to the flag (or to the car's next stop with untilStop)."
          },
          "driver": {
            "type": "string"
          },
          "storylineEvent": {
            "type": "boolean",
            "default": false,
            "description": "The event defines the race's storyline: Legend difficulty always runs it on its real lap instead of re-rolling it (eras spec section 8)."
          },
          "fault": {
            "enum": [
              "gear-stuck",
              "power-loss",
              "puncture",
              "tyre-failure"
            ],
            "description": "A FAULT's kind (simulator roadmap R2; pipeline/faults.py)."
          },
          "paceLoss": {
            "type": "number",
            "minimum": 0,
            "description": "A FAULT: seconds a green lap the faulted car loses while it lasts, fitted from the car's real laps after the fault."
          },
          "slowLap": {
            "type": "number",
            "minimum": 0,
            "description": "A FAULT: extra seconds on the fault's own lap (the forced slow lap of a puncture or tyre failure), fitted like paceLoss."
          },
          "untilStop": {
            "type": "boolean",
            "description": "A FAULT that lasts until the car's next stop (a puncture or failed tyre is fixed by new tyres)."
          }
        },
        "if": {
          "properties": {
            "type": {
              "const": "FAULT"
            }
          }
        },
        "then": {
          "required": [
            "driver",
            "fault",
            "paceLoss"
          ]
        }
      }
    },
    "decisionMoments": {
      "type": "array",
      "description": "Approved decision moments (data/moments/<race>.json; proposed by the sim's moment finder, picked by a human). The calls in each option are validated by the simulator.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lap",
          "trigger",
          "target",
          "options",
          "realOptionId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lap": {
            "type": "integer",
            "minimum": 1
          },
          "trigger": {
            "enum": [
              "SC",
              "VSC",
              "rivalPit",
              "undercut",
              "cliff",
              "takeover",
              "rain",
              "drying",
              "fault"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "kind"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "decisions"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "decisions": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "realOptionId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "candidateMomentLaps": {
      "type": "array",
      "description": "Laps with a strategic event after takeover (SC/VSC starts, stops): input for the moment finder.",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "realResult": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userSide": {
      "type": "string",
      "description": "Driver code the user controls — always the hard/controversial side."
    },
    "rival": {
      "type": "string",
      "description": "Driver code of the direct rival, which reacts to the user's calls; every other car follows its real strategy."
    },
    "reconstructed": {
      "type": "boolean",
      "description": "True for hand-built races without official lap timing (labelled in the UI). Must agree with provenance.kind when both are set."
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curves",
        "wetness"
      ],
      "description": "A wet race (docs/weather-spec.md): the share of a dry lap each tyre class loses at wetness w (data/wet.json) and the track's wetness on each lap (index lap - 1), fitted by pipeline/wet.py.",
      "properties": {
        "curves": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slick",
            "inter",
            "wet"
          ],
          "properties": {
            "slick": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a",
                "b"
              ],
              "properties": {
                "a": {
                  "type": "number",
                  "minimum": 0
                },
                "b": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "inter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "dry",
                "wet",
                "best"
              ],
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0
                },
                "dry": {
                  "type": "number",
                  "minimum": 0
                },
                "wet": {
                  "type": "number",
                  "minimum": 0
                },
                "best": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "wet": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "dry",
                "wet",
                "best"
              ],
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0
                },
                "dry": {
                  "type": "number",
                  "minimum": 0
                },
                "wet": {
                  "type": "number",
                  "minimum": 0
                },
                "best": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "wetness": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "eras": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eraId",
        "order"
      ],
      "description": "Eras mode (eras spec section 11). Daily and Gauntlet ignore it. Only eraId and order are required so a race can join an era before its content is written; the content checklist (spec section 15) requires the rest before it is published.",
      "properties": {
        "eraId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "The era (1 = turbo era ... 10 = ground-effect era), not the play order."
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "The race's number within its era."
        },
        "userSide": {
          "$ref": "#/$defs/driverCode",
          "description": "The driver the player runs in Eras (the one with more hard calls, eras spec section 4). Absent: the top-level userSide. It may differ from the Daily side of a race in both pools."
        },
        "target": {
          "$ref": "#/$defs/erasTarget",
          "description": "The star 1 target."
        },
        "storyline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "real",
            "rewriteCondition",
            "headline"
          ],
          "properties": {
            "real": {
              "type": "string",
              "minLength": 1,
              "description": "What really happened."
            },
            "rewriteCondition": {
              "$ref": "#/$defs/erasTarget",
              "description": "The result that rewrites the storyline, from the player's side."
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "description": "An original history-book headline (never quoted team radio)."
            }
          }
        },
        "mastery": {
          "$ref": "#/$defs/erasObjective"
        },
        "hidden": {
          "$ref": "#/$defs/erasObjective"
        },
        "hardCalls": {
          "type": "object",
          "description": "Hard calls per storyline driver (driver code -> count), written by `pipeline hard-calls`.",
          "propertyNames": {
            "minLength": 2,
            "maxLength": 4
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "briefing": {
          "type": "string",
          "minLength": 1,
          "description": "The short era-appropriate intro shown before the race."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "Where the race's data came from. Absent: real, nothing estimated.",
      "properties": {
        "kind": {
          "enum": [
            "real",
            "reconstructed"
          ],
          "description": "real: built from lap timing; reconstructed: fitted to results and race reports (labelled in the UI)."
        },
        "estimated": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "description": "Fields estimated rather than measured (eras build plan 2.4): stint compounds, safety-car laps, fuel loads, the wetness timeline.",
          "items": {
            "enum": [
              "compounds",
              "safetyCars",
              "fuelLoads",
              "weather"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "description": "The race's sporting rules (roadmap R5). Each absent field keeps today's behaviour; drs and ers default to the era's headset.json block. Behaviour lands in eras build plan 4.1 / 4.2.",
      "properties": {
        "twoCompound": {
          "type": "boolean",
          "default": true,
          "description": "A dry race must use two dry compounds (2007+)."
        },
        "tyreChanges": {
          "type": "boolean",
          "default": true,
          "description": "False: a stop only refuels (2005)."
        },
        "refuelling": {
          "type": "boolean",
          "default": false,
          "description": "Stops refuel (1994-2009, and 1983)."
        },
        "fuelLimit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The fixed race fuel allowance in kg (1984-88). Absent: no cap."
        },
        "pitLaneClosedUnderSC": {
          "type": "boolean",
          "default": false,
          "description": "The pit lane closes when the SC is called; a stop takes a penalty (2007-09)."
        },
        "vsc": {
          "type": "boolean",
          "default": true,
          "description": "A virtual safety car exists (2015+)."
        },
        "drs": {
          "type": "boolean",
          "description": "DRS and the wait-drs move. Absent: the era block's drs."
        },
        "ers": {
          "enum": [
            "none",
            "kers",
            "hybrid"
          ],
          "description": "The battery: none, KERS (2009, 2011-13) or the hybrid ERS (2014+). Absent: the era block's (an ers mode means hybrid)."
        }
      },
      "if": {
        "required": [
          "fuelLimit"
        ]
      },
      "then": {
        "properties": {
          "refuelling": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "driverCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4
    },
    "erasTarget": {
      "description": "A result condition from the player's side (eras spec section 6 targets). position/deny count from P1: position N means P N or better; deny N means the rival finishes P N or worse (or doesn't finish). team: positions[0] is the player's car and positions[1] its teammate, each at or better.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "win"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "defend"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "position"
          ],
          "properties": {
            "type": {
              "const": "position"
            },
            "position": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "rival"
          ],
          "properties": {
            "type": {
              "const": "beat-rival"
            },
            "rival": {
              "$ref": "#/$defs/driverCode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "positions"
          ],
          "properties": {
            "type": {
              "const": "team"
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "rival",
            "position"
          ],
          "properties": {
            "type": {
              "const": "deny"
            },
            "rival": {
              "$ref": "#/$defs/driverCode"
            },
            "position": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      ]
    },
    "erasObjective": {
      "description": "A mastery or hidden objective (eras spec section 6): one of the 8 types with its parameters, and the label the UI shows.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "label"
          ],
          "properties": {
            "type": {
              "const": "stop_count"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "exact": {
              "type": "integer",
              "minimum": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "max"
              ]
            },
            {
              "required": [
                "exact"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "label"
          ],
          "properties": {
            "type": {
              "const": "beat_real_call"
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "label",
            "position"
          ],
          "properties": {
            "type": {
              "const": "finish_position"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "position": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "label",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "margin"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "label"
          ],
          "properties": {
            "type": {
              "const": "compound_rule"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "mustUse": {
              "type": "string",
