{
  "name": "laststint",
  "version": "0.0.0",
  "private": true,
  "description": "Daily F1 strategy game — monorepo (pipeline, sim, web, worker)",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3",
    "wrangler": "^4.152.0"
  }
}
