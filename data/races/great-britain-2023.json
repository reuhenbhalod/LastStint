    "storyline": {
      "real": "Norris takes the lead at the start, but Verstappen is back past within five laps and leads the rest of the way. McLaren stops Piastri from third on lap 29; three laps later Magnussen's engine fails and the safety car comes out. Norris, Verstappen and Hamilton all stop under it: Norris gets hards, Verstappen and Hamilton take softs. Norris holds Hamilton off at the restart and finishes second, 3.8 s behind Verstappen and 3.0 s ahead of Hamilton.",
      "rewriteCondition": {
        "type": "win"
      },
      "headline": "Norris beats Verstappen at Silverstone"
    },
    "mastery": {
      "type": "compound_rule",
