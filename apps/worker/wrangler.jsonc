{
  // Cloudflare Worker — API + score verification + daily queue-check cron.
  // The web app deploys separately to Cloudflare Pages (apps/web), so this Worker
  // serves no static assets.
  "name": "pitwall",
  // Reuhen's Cloudflare account, which hosts the Worker and pitwall-db (CI sets the same ID
  // from its CLOUDFLARE_ACCOUNT_ID secret).
  "account_id": "20a233209db4b2680328a2c547039f17",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",

  // D1 database. Create it once with:
  //   npx wrangler d1 create pitwall-db
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitwall-db",
      "database_id": "38a00e61-49eb-419f-9c3d-47571ca20dd7"
    }
  ],

  // Versus mode's rooms (docs/versus-spec.md V5): one Durable Object per match.
  "durable_objects": { "bindings": [{ "name": "VERSUS", "class_name": "VersusRoom" }] },
  "migrations": [{ "tag": "versus-v1", "new_sqlite_classes": ["VersusRoom"] }],

  // Daily queue-check cron (Implementation Plan 4.6) — handled by scheduled() in src/index.ts.
  "triggers": { "crons": ["0 9 * * *"] },

  // The website's origin, allowed to call /api/* (CORS): the pitwall-web Worker (apps/web).
  // Local dev (localhost:5173) is always allowed.
  // GOOGLE_CLIENT_ID: the Google OAuth client for sign-in (public; not a secret). Its
  // authorized origins are the website and http://localhost:5173.
  "vars": {
    "WEB_ORIGIN": "https://pitwall-web.boxboxbox.workers.dev",
    "GOOGLE_CLIENT_ID": "318278030629-s860fnjjpk6ihcn4iubjqiakf8vu0pqi.apps.googleusercontent.com",
    // Auth0 (docs/auth0-spec.md): set, sign-in takes Auth0 ID tokens instead of Google's.
    "AUTH0_DOMAIN": "dev-umxcdh2y62l4e0gy.us.auth0.com",
    "AUTH0_CLIENT_ID": "Pdlxz3iAqJse61VUhOGpF8wSeFgV7yxM",
    // Admins (the /admin page): Google account emails, comma-separated. Add yours here.
    "ADMIN_EMAILS": "purohit.abhiram@gmail.com,reuhenbhalod@gmail.com",
    // Eras test mode (eras spec §5, §16): every era and race open, Draft races shown.
    // Always false in production; only the staging env below turns it on.
    "ERAS_TEST_MODE": "false"
  },

  // Run submissions per IP (Phase 4 spec C1). namespace_id is any account-unique number.
  "ratelimits": [
    { "name": "RUNS_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } }
  ],

  // Queue alerts (Phase 4 spec C3): optionally set a Discord or Slack webhook with
  //   npx wrangler secret put ALERT_WEBHOOK

  "observability": { "enabled": true },

  // Staging (docs/staging.md): the pitwall-staging Worker on its own D1, with Eras test mode
  // on. Deploy with `wrangler deploy --env staging`. Wrangler does not inherit vars, D1,
  // triggers or ratelimits into an env, so each is set here.
  "env": {
    "staging": {
      "name": "pitwall-staging",
      // Versus mode's rooms: Durable Object bindings aren't inherited into an env either.
      "durable_objects": { "bindings": [{ "name": "VERSUS", "class_name": "VersusRoom" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pitwall-staging-db",
          "database_id": "6841f86e-2b24-416b-ae9e-ba3d3793a573"
        }
      ],
      // No daily queue-check cron: staging has no schedule to watch and no alert webhook.
      "triggers": { "crons": [] },
      // No RUNS_LIMITER: the API skips rate limiting when it is unbound. To add one, give it a
      // namespace_id of its own (not production's 4101), e.g.
      //   "ratelimits": [{ "name": "RUNS_LIMITER", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }]
      "ratelimits": [],
      "vars": {
        // The staging website (pitwall-web-staging, apps/web env.staging). localhost:5173 is
        // always allowed too, so a local web build pointed at this API also works.
        "WEB_ORIGIN": "https://pitwall-web-staging.boxboxbox.workers.dev",
        "GOOGLE_CLIENT_ID": "318278030629-s860fnjjpk6ihcn4iubjqiakf8vu0pqi.apps.googleusercontent.com",
        "AUTH0_DOMAIN": "dev-umxcdh2y62l4e0gy.us.auth0.com",
        "AUTH0_CLIENT_ID": "Pdlxz3iAqJse61VUhOGpF8wSeFgV7yxM",
        "ADMIN_EMAILS": "purohit.abhiram@gmail.com,reuhenbhalod@gmail.com",
        "ERAS_TEST_MODE": "true"
      }
    }
  }
}
