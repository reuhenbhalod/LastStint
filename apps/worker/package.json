{
  "name": "@laststint/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "migrate:local": "wrangler d1 migrations apply pitwall-db --local",
    "migrate:remote": "wrangler d1 migrations apply pitwall-db --remote",
    "migrate:staging": "wrangler d1 migrations apply pitwall-staging-db --remote --env staging",
    "deploy:staging": "tsx scripts/races.ts && wrangler deploy --env staging",
    "test": "vitest run",
    "races": "tsx scripts/races.ts",
    "schedule": "tsx scripts/schedule.ts",
    "reverify": "tsx scripts/reverify.ts",
    "predev": "tsx scripts/races.ts",
    "predeploy": "tsx scripts/races.ts",
    "smoke": "tsx scripts/smoke.ts",
    "tickets:seed:local": "tsx scripts/tickets-seed.ts && wrangler d1 execute pitwall-db --local --file data/tickets-seed.sql",
    "tickets:seed:remote": "tsx scripts/tickets-seed.ts && wrangler d1 execute pitwall-db --remote --file data/tickets-seed.sql"
  },
  "dependencies": {
    "@laststint/sim": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "wrangler": "^4"
  }
}
