{
  "name": "@boxthislap/tickets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply boxthislap-tickets --local",
    "migrate:remote": "wrangler d1 migrations apply boxthislap-tickets --remote",
    "seed:sql": "tsx scripts/seed.ts",
    "seed:local": "tsx scripts/seed.ts && wrangler d1 execute boxthislap-tickets --local --file data/seed.sql",
    "seed:remote": "tsx scripts/seed.ts && wrangler d1 execute boxthislap-tickets --remote --file data/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
