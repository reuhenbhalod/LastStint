{
  // The team's ticket tracker: one Worker that serves the built React app (dist/, as static
  // assets) and the JSON API under /api/* (src/worker). Same origin, so no CORS.
  "name": "boxthislap-tickets",
  // Reuhen's Cloudflare account, the same one that hosts apps/worker and apps/web.
  "account_id": "20a233209db4b2680328a2c547039f17",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-13",
  // Public at https://boxthislap-tickets.boxboxbox.workers.dev, with no sign-in: anyone with the
  // URL can read and change tickets (README.md).
  "workers_dev": true,

  // The app's files (built by `vite build`). /api/* always reaches the Worker; every other path
  // is a file, or the app's index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Its own D1 database (not the game's pitwall-db). Create it once with:
  //   pnpm exec wrangler d1 create boxthislap-tickets
  // then replace REPLACE_AFTER_D1_CREATE with the database_id it prints. Local dev and the
  // tests use a local D1, so they work with the placeholder.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boxthislap-tickets",
      "database_id": "REPLACE_AFTER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
